---
# SecureBlue Deployment Secrets
# Copy to vars.yml and fill in your values

# User UIDs (can be customized)
nextcloud_uid: 82
proxy_uid: 1001
monitoring_uid: 1002

# Nextcloud Database
nextcloud_db_name: nextcloud
nextcloud_db_user: nextcloud
nextcloud_db_password: <generate-a-strong-password>
nextcloud_db_root_password: <generate-a-strong-password>

# Nextcloud Admin
nextcloud_admin_user: admin
nextcloud_admin_password: <generate-a-strong-password>

# Nextcloud Domain
nextcloud_trusted_domains: cloud.your-domain.de
nextcloud_url: https://cloud.your-domain.de

# Nextcloud PHP tuning
nextcloud_php_max_children: 20
nextcloud_php_upload_limit: 15G
nextcloud_php_memory_limit: 6G
nextcloud_max_body_size: 15G

# Bunkerweb
bunker_server_name: cloud.your-domain.de
bunker_letsencrypt_email: admin@your-domain.de
bunker_whitelist_country: DE CH AT
bunker_api_whitelist_ip: 127.0.0.1 10.0.0.0/8
bunker_limit_req_rate: 3r/s
