#!/bin/bash
# restic from its official image, as root, with this host's repository in
# /etc/restic.env. It sees no host path of its own: RESTIC_PODMAN_ARGS adds
# the mounts, such as the snapshots of a backup or the target of a restore.
# shellcheck disable=SC2086
exec podman run --rm -i --security-opt label=disable \
	--hostname "$(hostname)" --env-file /etc/restic.env -v restic-cache:/root/.cache/restic \
	${RESTIC_PODMAN_ARGS:-} {{ base_setup_restic_image }} "$@"
